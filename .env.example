# ============================================================
# Promobot — copie para `.env` e preencha o que precisar
#   cp .env.example .env
# Todas as variáveis usam o prefixo PROMOBOT_.
# ============================================================

# --- Banco de dados -----------------------------------------------------
# Local (padrão): SQLite em ./data/promobot.db
# Produção (painel na Vercel + coletor na sua máquina): use o MESMO Postgres
# nos dois lados, ex. Neon (https://neon.tech, free tier):
#   PROMOBOT_DATABASE_URL=postgresql://usuario:senha@host.neon.tech/promobot?sslmode=require
# PROMOBOT_DATABASE_URL=sqlite:///./data/promobot.db

# --- Painel (preencha se for expor além do localhost / VPS) ---
PROMOBOT_SESSION_SECRET=troque-por-uma-chave-aleatoria
PROMOBOT_AUTH_USER=
PROMOBOT_AUTH_PASS=

# --- IA Gemini (obtenha grátis em https://aistudio.google.com/apikey) ---
PROMOBOT_GEMINI_API_KEY=
PROMOBOT_GEMINI_MODEL=gemini-2.5-flash
PROMOBOT_GEMINI_MAX_PER_CYCLE=20
PROMOBOT_GEMINI_DELAY_S=3
PROMOBOT_INSTANT_ALERT_SCORE=80

# --- E-mail (ex.: Gmail com "senha de app" em myaccount.google.com/apppasswords) ---
PROMOBOT_SMTP_HOST=smtp.gmail.com
PROMOBOT_SMTP_PORT=587
PROMOBOT_SMTP_USER=
PROMOBOT_SMTP_PASS=
PROMOBOT_EMAIL_FROM=Promobot <seu-email@gmail.com>
PROMOBOT_EMAIL_TO=seu-email@gmail.com
PROMOBOT_DIGEST_HOUR=8

# --- Coleta ---
PROMOBOT_CRAWL_INTERVAL_MINUTES=30
PROMOBOT_MIN_DELAY_S=2
PROMOBOT_MAX_DELAY_S=5
PROMOBOT_RESULTS_PER_KEYWORD=40
PROMOBOT_BREAKER_FAIL_THRESHOLD=3
PROMOBOT_BREAKER_COOLDOWN_HOURS=2

# --- Anti-spam de alertas ---
PROMOBOT_ALERT_RATE_LIMIT_MINUTES=60
PROMOBOT_REPEAT_ALERT_HOURS=72
PROMOBOT_REPEAT_ALERT_EXTRA_DROP_PCT=5

# --- Palavras-chave iniciais (só na 1ª execução; depois gerencie no painel) ---
PROMOBOT_KEYWORDS=ps5,rtx 4060,steam deck,notebook gamer

# --- Diversos ---
PROMOBOT_LOG_LEVEL=INFO
# VPS/Docker do coletor: mantenha false (ou remova a variável, pois false é o padrão).
# Vercel/testes: true, para nunca iniciar Playwright ou o agendador no processo web.
PROMOBOT_DISABLE_SCHEDULER=false
